# DJ Library Pipeline — configuration
# Copy to .env and fill in your values.

# Required: Discogs personal access token
# Get one at: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your_token_here

# Required: paths to your music folders
INBOX_PATH=/path/to/dj/inbox
LIBRARY_PATH=/path/to/music/library
XML_PATH=/path/to/rekordbox/rekordbox_library.xml
